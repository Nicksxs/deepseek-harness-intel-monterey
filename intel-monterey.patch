diff --git a/Start-Intel-Monterey.command b/Start-Intel-Monterey.command
new file mode 100755
index 0000000..f7b61e1
--- /dev/null
+++ b/Start-Intel-Monterey.command
@@ -0,0 +1,27 @@
+#!/bin/bash
+# Build and launch this source-linked desktop client on an Intel Mac.
+set -euo pipefail
+cd "$(dirname "$0")"
+fail() { printf '\n错误：%s\n' "$*" >&2; exit 1; }
+trap 'printf "\n启动未完成。请保留上面的错误输出；不会继续执行后续步骤。\n" >&2' ERR
+[[ "$(uname -s)" == Darwin ]] || fail '此启动器仅支持 macOS。'
+[[ "$(uname -m)" == x86_64 ]] || fail '此版本面向 Intel Mac，请使用原生 x64 终端和 Node.js。'
+OS_VERSION="$(sw_vers -productVersion)"
+[[ "${OS_VERSION%%.*}" -ge 12 ]] || fail '需要 macOS 12 或更高版本。'
+command -v node >/dev/null || fail '请先安装官方 Node.js 22.23.3 x64 完整发行版（包含开发头文件）。不要安装 Node.js 24。'
+node -e 'if(process.arch!=="x64" || process.versions.node.split(".")[0]!=="22" || Number(process.versions.node.split(".")[1])<19)process.exit(1)' || fail '需要 x64 Node.js 22.19 或更新的 22.x；推荐 22.23.3。'
+command -v pnpm >/dev/null || fail '请先准备 pnpm 11.7.0，然后重新启动。'
+[[ "$(pnpm --version)" == 11.7.0 ]] || fail '此源码锁定 pnpm 11.7.0，请切换到该版本。'
+xcode-select -p >/dev/null 2>&1 || fail '缺少 Xcode Command Line Tools。请先在终端运行 xcode-select --install 并完成安装。'
+command -v cc >/dev/null || fail '找不到 C 编译器，请检查 Xcode Command Line Tools。'
+node -e 'const fs=require("fs"),p=require("path");if(!fs.existsSync(p.resolve(p.dirname(process.execPath),"../include/node/node_api.h")))process.exit(1)' || fail 'Node.js 安装缺少 include/node/node_api.h；请使用官方完整发行版。'
+printf '\n正在安装项目依赖并编译桌面客户端，首次运行需要下载依赖和运行环境。\n'
+pnpm install --frozen-lockfile
+if [[ ! -e .git && -f SOURCE_REVISION ]]; then
+  export DSH_CLIENT_COMMIT_HASH="$(cat SOURCE_REVISION)"
+fi
+export DSH_DESKTOP_TARGET_PLATFORM=darwin
+export DSH_DESKTOP_TARGET_ARCH=x64
+export MACOSX_DEPLOYMENT_TARGET=12.0
+export DSH_DESKTOP_OPEN_DEVTOOLS=0
+pnpm run dev:desktop
